# =============================================================================
# Örnek Ortam Değişkenleri
# Bu dosyayı ".env" olarak kopyalayın ve kendi değerlerinizle doldurun:
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
#
# GÜVENLİK: SIM_MODE=false (üretim) iken aşağıdaki kritik sırlar BOŞ olamaz;
# eksikse sunucu başlamayı reddeder (config.js -> assertProductionSecrets).
# SIM_MODE=true iken eksik sırlar için geçici rastgele değerler üretilir (sahada kullanmayın).
# =============================================================================

# HTTP portal portu
PORT=3000

# SIMÜLASYON MODU
# true  -> Gerçek SMS GİTMEZ. OTP konsola/arayüze düşer. OTP doğrulanınca
#          sunucu, gerçek NAS'ı taklit ederek YEREL RADIUS'a otomatik oturum açar.
# false -> Gerçek NetGSM SMS'i gider, oturumları gerçek pfSense/ESP32 açar.
SIM_MODE=true

# --- NetGSM SMS OTP (SIM_MODE=false iken zorunlu) ---
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_HEADER=
NETGSM_APPKEY=
OTP_EXPIRE_MINUTES=3

# --- RADIUS (SIM_MODE=false iken RADIUS_SECRET zorunlu) ---
RADIUS_SECRET=
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_SERVER_HOST=127.0.0.1

# --- Oturum / Ağ profili ---
RATE_LIMIT=5M/2M
SESSION_TIMEOUT=7200
LAN_PREFIX=192.168.20
LEASE_START=100
LEASE_END=200

# --- Güvenlik: OTP akışı (F-01, F-06) ---
OTP_MAX_ATTEMPTS=5
OTP_FLOW_RETENTION_HOURS=24

# --- Güvenlik: hız sınırları (F-02) ---
RL_OTP_PER_MIN=1
RL_OTP_PER_HOUR=5
RL_OTP_PER_PHONE_DAY=10
RL_VERIFY_PER_MIN=10
RL_LOGIN_PER_15MIN=5

# --- Yönetici girişi (F-12, SIM_MODE=false iken zorunlu) ---
# Kullanıcı adı:
ADMIN_USER=admin
# Parola HASH'i (scrypt$salt$hash). Üretmek için:
#   node -e "console.log(require('./config').hashPassword('YENI_PAROLA'))"
# SIM_MODE'da bu boşsa ADMIN_PASSWORD (aşağıda) veya varsayılan 'admin123' kullanılır.
ADMIN_PASSWORD_HASH=
# Yalnızca SIM_MODE demosu için düz parola (üretimde ADMIN_PASSWORD_HASH kullanın):
ADMIN_PASSWORD=admin123
# Oturum çerezi imza sırrı (rastgele uzun bir değer):
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MIN=60

# --- ESP32 Access Point (F-03) ---
# Boş bırakılırsa ESP32'ye haber verilmez.
ESP32_AP_URL=
# Backend ile ESP32 arasında paylaşılan HMAC sırrı (esp32-bridge/secrets.h ile AYNI olmalı):
ESP32_SHARED_SECRET=
ESP32_CLOCK_TOLERANCE_SEC=30

# --- TLS (F-05) — sahada portal HTTPS olmalı ---
# Geliştirmede kendinden imzalı sertifika:
#   openssl req -x509 -newkey rsa:2048 -nodes -keyout key.pem -out cert.pem -days 365 -subj "/CN=localhost"
TLS_ENABLED=false
TLS_KEY_PATH=
TLS_CERT_PATH=

# --- TÜBİTAK Kamu SM Zaman Damgası (F-08) ---
KAMUSM_TSA_URL=http://zd.kamusm.gov.tr
SIGN_CRON=59 23 * * *
# Simülasyon damgası için HMAC anahtarı (gerçek dağıtımda gerçek TSA kullanılır):
KAMUSM_MOCK_KEY=

# --- Veri saklama (F-07) — 5651: iki yıl = 730 gün ---
RETENTION_SESSION_DAYS=730
RETENTION_LOG_DAYS=730

# --- Veri kotası (F-10) ---
# Bir oturum bu kadar MB'ı aşınca RADIUS sunucusu NAS'a RFC 5176
# Disconnect-Request gönderir ve oturumu kapatır. 0 = kota kapalı.
QUOTA_MB=0
# NAS'ın CoA/DM dinleme portu (pfSense/MikroTik varsayılanı 3799):
COA_PORT=3799
# Boş bırakılırsa muhasebe paketinin geldiği NAS adresi kullanılır:
COA_HOST=
